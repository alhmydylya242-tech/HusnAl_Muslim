import 'package:flutter/material.dart';

final GlobalKey<NavigatorState> navigatorKey = GlobalKey<NavigatorState>();
final GlobalKey<ScaffoldMessengerState> scaffoldMessengerKey = GlobalKey<ScaffoldMessengerState>();

void main() {
  runApp(const FullPropertyApp());
}

class FullPropertyApp extends StatelessWidget {
  const FullPropertyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      home: const HomePage(),
      title: 'واجب تطبيق 15 خاصية',
      theme: ThemeData(primarySwatch: Colors.indigo),
      debugShowCheckedModeBanner: true,
      color: Colors.blueAccent,
      routes: {'/settings': (context) => const SettingsScreen()},
      initialRoute: '/',
      supportedLocales: const [Locale('ar', 'SA'), Locale('en', 'US')],
      themeMode: ThemeMode.light,
      darkTheme: ThemeData.dark(),
      navigatorKey: navigatorKey,
      scaffoldMessengerKey: scaffoldMessengerKey,
      showPerformanceOverlay: false,
      showSemanticsDebugger: false,
      highContrastTheme: ThemeData.highContrast(),
      builder: (context, child) {
        return Directionality(
          textDirection: TextDirection.rtl,
          child: child!,
        );
      },
    );
  }
}

class SettingsScreen extends StatelessWidget {
  const SettingsScreen({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('صفحة الإعدادات')),
      body: const Center(child: Text('هذه هي صفحة الإعدادات')),
    );
  }
}

class HomePage extends StatelessWidget {
  const HomePage({super.key});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('الخواص العملية'),
        actions: [
          IconButton(
            icon: const Icon(Icons.settings),
            onPressed: () {
              Navigator.pushNamed(context, '/settings');
            },
          ),
        ],
      ),
      backgroundColor: Colors.blueGrey[50],
      drawer: const Drawer(child: Center(child: Text('القائمة الجانبية'))),
      endDrawer: const Drawer(child: Center(child: Text('قائمة النهاية'))),
      floatingActionButton: FloatingActionButton(onPressed: () {} , child: const Icon(Icons.add)),
      floatingActionButtonLocation: FloatingActionButtonLocation.centerDocked,
      bottomNavigationBar: BottomAppBar(
        color: Colors.indigo,
        child: Row(
          children: const [
            Spacer(),
            Text('شريط التنقل السفلي', style: TextStyle(color: Colors.white)),
            Spacer(),
          ],
        ),
      ),
      bottomSheet: Container(height: 50, color: Colors.yellow, child: const Center(child: Text('ورقة منبثقة (BottomSheet)'))),
      primary: true,
      resizeToAvoidBottomInset: true,
      extendBody: true,
      extendBodyBehindAppBar: false,
      persistentFooterButtons: [
        TextButton(onPressed: (){}, child: const Text('زر سفلي 1')),
        TextButton(onPressed: (){}, child: const Text('زر سفلي 2')),
      ],
      onDrawerChanged: (isOpened) {
        print('Drawer is opened: $isOpened');
      },
      onEndDrawerChanged: (isOpened) {
        print('EndDrawer is opened: $isOpened');
      },
      body: Center(
        child: SingleChildScrollView(
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              Container(
                child: const Text('حاوية تطبق 15 خاصية', style: TextStyle(color: Colors.white, fontSize: 16)),
                width: 300,
                height: 150,
                alignment: Alignment.center,
                padding: const EdgeInsets.all(20),
                margin: const EdgeInsets.only(top: 10, bottom: 30),
                constraints: const BoxConstraints(minHeight: 100),
                transform: Matrix4.rotationZ(0.05),
                clipBehavior: Clip.antiAlias,
                decoration: BoxDecoration(
                  color: Colors.indigo[400],
                  borderRadius: BorderRadius.circular(30),
                  border: Border.all(color: Colors.black, width: 3),
                  boxShadow: const [
                    BoxShadow(
                      color: Colors.black45,
                      offset: Offset(4, 4),
                      blurRadius: 10,
                    ),
                  ],
                  shape: BoxShape.rectangle,
                ),
              ),
              const SizedBox(height: 100),
            ],
          ),
        ),
      ),
    );
  }
}